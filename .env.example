# --- Resend (envío de PDF por correo) ---
RESEND_API_KEY=
# Debe ser un remitente de un dominio verificado en Resend, ej. "Power Delivery <check7@powerdelivery.mx>"
RESEND_FROM_EMAIL="Power Delivery <onboarding@resend.dev>"

# --- Monday.com (item por cada servicio) ---
MONDAY_API_TOKEN=
MONDAY_BOARD_ID=
# Opcional: ID del grupo dentro del tablero donde crear el item
MONDAY_GROUP_ID=

# IDs de columna del tablero de Monday. Todas son opcionales: una columna solo
# se envía si su ID está definido aquí. Consíguelos abriendo la columna en
# Monday > "..." > "Editar" (o vía la API con board(ids: BOARD_ID){ columns { id title } }).
MONDAY_COL_FOLIO=
MONDAY_COL_FECHA=
MONDAY_COL_TECNICO=
MONDAY_COL_ID_CLIENTE=
MONDAY_COL_CORREO=
MONDAY_COL_VEHICULO=
MONDAY_COL_PLACA=
MONDAY_COL_KM=
MONDAY_COL_DIAG_BATERIA=
MONDAY_COL_DIAG_ALTERNADOR=
MONDAY_COL_CALIFICACION=
MONDAY_COL_SERVICIOS=

# --- Solo para desarrollo local (generación de PDF) ---
# Ruta al ejecutable de Chrome en tu Mac, si no está en la ubicación por defecto.
# CHROME_EXECUTABLE_PATH="/Applications/Google Chrome.app/Contents/MacOS/Google Chrome"
